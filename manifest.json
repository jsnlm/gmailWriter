{
  "manifest_version": 3,
  "name": "Gmail AI Drafter",
  "version": "1.0.0",
  "description": "AI-powered email reply drafting for Gmail",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.deepseek.com/*",
    "https://api.mistral.ai/*",
    "https://api.x.ai/*",
    "https://api.groq.com/*",
    "https://api.cohere.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/content/index.tsx"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/index.html",
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Alt+R",
        "mac": "Alt+R"
      },
      "description": "Toggle Gmail AI Drafter sidebar"
    }
  },
  "icons": {
    "16": "public/icons/icon16.png",
    "32": "public/icons/icon32.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["public/icons/icon128.png", "public/icons/icon-on-blue.svg"],
      "matches": ["https://mail.google.com/*"]
    }
  ],
  "action": {
    "default_icon": {
      "16": "public/icons/icon16.png",
      "32": "public/icons/icon32.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    },
    "default_title": "Gmail AI Drafter"
  }
}
